NODE_ENV=development
PORT=4000

# Use the full MongoDB Atlas connection string, not only the cluster name.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Cloudinary credentials are provided through one URL.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_TIMEOUT_MS=20000

# Comma-separated origins are supported for local development or multiple deployments.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SAME_SITE=lax

# Vercel Functions have a roughly 4.5 MB total request limit.
MAX_IMAGE_BYTES=786432
MAX_REQUEST_BYTES=4000000
